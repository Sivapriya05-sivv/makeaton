generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                  @id @default(autoincrement())
  email        String               @unique
  passwordHash String
  name         String
  role         String               @default("customer") // admin | staff | customer
  createdAt    DateTime             @default(now())
  resetTokens  PasswordResetToken[]
  subscriptions Subscription[]
  invoices     Invoice[]

  @@index([role])
}

model PasswordResetToken {
  token     String   @id
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Product {
  id                Int                @id @default(autoincrement())
  name              String
  type              String
  salesPrice        Float
  costPrice         Float              @default(0)
  notes             String             @default("")
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  variants          ProductVariant[]
  plans             Plan[]
  subscriptionLines SubscriptionLine[]

  @@index([active])
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  name       String
  priceDelta Float   @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Plan {
  id              Int            @id @default(autoincrement())
  name            String
  productId       Int
  variantId       Int?
  price           Float
  billingInterval String         // daily|weekly|monthly|yearly
  minQuantity     Int            @default(1)
  availableFrom   DateTime
  availableTo     DateTime?
  closePolicy     String         @default("auto") // auto|early|pause|renew
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  product         Product        @relation(fields: [productId], references: [id])
  subscriptions   Subscription[]

  @@index([active])
}

model TaxRate {
  id        Int      @id @default(autoincrement())
  name      String
  rate      Float    // 0.18 = 18%
  appliesTo String   @default("all") // product type or 'all'
  createdAt DateTime @default(now())
}

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String             @unique
  customerId      Int
  planId          Int
  startDate       DateTime
  expiryDate      DateTime?
  paymentTerms    String?
  nextBillingDate DateTime?
  state           String             @default("draft")
  paused          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  plan            Plan               @relation(fields: [planId], references: [id])
  customer        User               @relation(fields: [customerId], references: [id])
  lines           SubscriptionLine[]
  invoices        Invoice[]

  @@index([customerId])
  @@index([state])
}

model SubscriptionLine {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  productId      Int
  variantId      Int?
  qty            Int
  unitPrice      Float
  taxId          Int?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])

  @@index([subscriptionId])
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  number             String        @unique
  subscriptionId     Int
  customerId         Int
  issueDate          DateTime
  dueDate            DateTime
  state              String        @default("draft")  // draft|confirmed|paid|cancelled
  subtotal           Float         @default(0)
  taxTotal           Float         @default(0)
  discountTotal      Float         @default(0)
  grandTotal         Float         @default(0)
  amountPaid         Float         @default(0)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  createdAt          DateTime      @default(now())
  lines              InvoiceLine[]
  payments           Payment[]
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id])
  customer           User          @relation(fields: [customerId], references: [id])

  @@unique([subscriptionId, billingPeriodStart])   // ⭐ IDEMPOTENCY
  @@index([customerId])
  @@index([state, dueDate])
}

model InvoiceLine {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  productId      Int?
  description    String
  qty            Int
  unitPrice      Float
  taxId          Int?
  taxRate        Float    @default(0)
  discountAmount Float    @default(0)
  amount         Float
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  method     String
  amount     Float
  paidOn     DateTime
  note       String   @default("")
  recordedBy Int?
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  entity    String
  entityId  Int
  fromState String?
  toState   String
  at        DateTime @default(now())

  @@index([entity, entityId])
}


model Discount {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  percentage  Float    @default(10)
  scope       String   @default("subscription")
  minPurchase Float    @default(2000)
  startDate   DateTime
  endDate     DateTime
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([code])
}
